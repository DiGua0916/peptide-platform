msgstr "首页显示什么。"

msgid "Permalinks"
msgstr "固定链接"

msgid "The address format of pages and products."
msgstr "页面和商品的网址格式。"

msgid "Privacy policy page"
msgstr "隐私政策页面"

msgid "Which page is the privacy policy."
msgstr "哪个页面是隐私政策。"

msgid "Discussion"
msgstr "讨论"

msgid "Review moderation and blocked words."
msgstr "评论审核和屏蔽词。"

msgid "Export personal data"
msgstr "导出个人数据"

