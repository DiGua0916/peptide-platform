msgstr "后台任务，例如像素回传和提醒邮件。"

msgid "Site health"
msgstr "站点健康"

msgid "Security and performance checks from WordPress."
msgstr "WordPress 自带的安全和性能检查。"

msgid "WooCommerce settings"
msgstr "WooCommerce 设置"

msgid "General, products, accounts and advanced WooCommerce options."
msgstr "WooCommerce 的常规、商品、账户和高级选项。"

msgid "VialCove settings"
msgstr "VialCove 设置"

msgid "Brand name, demo mode, use statement, checkout confirmation, batch check, support button."
msgstr "品牌名称、演示模式、用途声明、结账确认、批次检查、客服按钮。"

msgid "WordPress general settings"
msgstr "WordPress 常规设置"

msgid "Tagline, site address, date format."
msgstr "副标题、站点网址、日期格式。"

msgid "Reading"
msgstr "阅读设置"

