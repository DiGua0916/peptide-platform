msgstr "顾客要求删除自己的资料时使用。"

msgid "All accounts on the store"
msgstr "店铺上的全部账号"

msgid "Administrators, salespeople and customers (WordPress user list)."
msgstr "管理员、销售和顾客（WordPress 用户列表）。"

msgid "Enter the server’s IP address, for example 203.0.113.10."
msgstr "请输入服务器的 IP 地址，例如 203.0.113.10。"

msgid "Stores still use this server. Move them to another server first."
msgstr "还有店铺在用这台服务器，请先把它们换到别的服务器。"

msgid "Server not found."
msgstr "找不到这台服务器。"
