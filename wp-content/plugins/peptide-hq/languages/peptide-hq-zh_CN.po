msgid "Peptide HQ"
msgstr "Peptide HQ（总后台）"

msgid "Master admin for all VialCove stores: sales and orders of every store, alerts, one-click login and salesperson accounts."
msgstr "VialCove 所有店铺的总后台：每个店铺的销售和订单、告警、一键登录和销售账号。"

msgid "DiGua"
msgstr "DiGua"

msgid "Salesperson accounts"
msgstr "销售账号"

msgid "Add salesperson account"
msgstr "添加销售账号"

msgid "Each store is run by one salesperson. Their account lives on the store; create and change it here. The master admin does not keep their password."
msgstr "每个店铺由一个销售负责。销售账号存在店铺里，在这里新建和修改。总后台不保存销售的密码。"

msgid "No store has joined yet."
msgstr "还没有店铺接入。"

msgid "How stores join"
msgstr "店铺怎么接入"

msgid "Store"
msgstr "店铺"

msgid "This store has no salesperson account yet."
msgstr "这个店铺还没有销售账号。"

msgid "Account"
msgstr "账号"

msgid "Name"
msgstr "姓名"

msgid "Email"
msgstr "邮箱"

msgid "Menus they can use"
msgstr "能用的菜单"

msgid "Status"
msgstr "状态"

msgid "Last login"
msgstr "最后登录"

msgid "Actions"
msgstr "操作"

msgid "None"
msgstr "无"

msgid "Enable this account?"
msgstr "启用这个账号？"

msgid "Disable this account? The salesperson is logged out at once and cannot log in until enabled again."
msgstr "停用这个账号？销售会马上被退出登录，重新启用前不能登录。"

msgid "Disabled"
msgstr "已停用"

msgid "Enabled"
msgstr "已启用"

msgid "Edit"
msgstr "编辑"

msgid "Delete this salesperson account from the store? Its posts and products are kept and moved to the store administrator."
msgstr "从店铺删除这个销售账号？他发布的博客和商品会保留，转给店铺管理员。"

msgid "Delete"
msgstr "删除"

msgid "Edit salesperson account"
msgstr "编辑销售账号"

msgid "Account name"
msgstr "账号"

msgid "Password"
msgstr "密码"

msgid "Leave empty to keep the current password. A new password logs the salesperson out everywhere."
msgstr "留空则不修改密码。设置新密码后，销售在所有地方都会被退出登录。"

msgid "At least %d characters. Tell the salesperson the account name and password yourself."
msgstr "至少 %d 位。请自己把账号和密码告诉销售。"

msgid "Menus the salesperson can use in the store admin"
msgstr "销售在店铺后台能用的菜单"

msgid "Users, plugins and WordPress settings always stay with the administrator."
msgstr "用户、插件和 WordPress 设置始终只有管理员能用。"

msgid "Disable this account (cannot log in)"
msgstr "停用这个账号（不能登录）"

msgid "Save"
msgstr "保存"

msgid "Create account on the store"
msgstr "在店铺上创建账号"

msgid "Cancel"
msgstr "取消"

msgid "Alerts"
msgstr "告警"

msgid "Stores are checked every 10 minutes. New alerts are also emailed to %s. An alert closes by itself when the problem is gone."
msgstr "每 10 分钟检查一次所有店铺。新告警也会发邮件到 %s。问题消失后，告警会自动关闭。"

msgid "Open"
msgstr "未处理"

msgid "No open alerts. All stores look fine."
msgstr "没有未处理的告警，所有店铺都正常。"

msgid "Problem"
msgstr "问题"

msgid "Details"
msgstr "详情"

msgid "Since"
msgstr "开始时间"

msgid "Mark as handled"
msgstr "标记为已处理"

msgid "Recently closed"
msgstr "最近已关闭"

msgid "From"
msgstr "开始"

msgid "Closed"
msgstr "关闭时间"

msgid "Today"
msgstr "今天"

msgid "Yesterday"
msgstr "昨天"

msgid "Last 7 days"
msgstr "近 7 天"

msgid "Last 30 days"
msgstr "近 30 天"

msgid "%s vs previous period"
msgstr "比上一段 %s"

msgid "Overview"
msgstr "概览"

msgid "Refresh all stores now"
msgstr "立即刷新所有店铺"

msgid "No store has joined yet"
msgstr "还没有店铺接入"

msgid "Stores join by themselves once their wp-config.php has the two master admin lines. The lines are on the Stores page."
msgstr "店铺的 wp-config.php 里加了总后台的两行以后，会自己接入。这两行在“店铺”页面上。"

msgid "Time range"
msgstr "时间范围"

msgid "%1$s · updated %2$s (every 10 minutes)"
msgstr "%1$s · %2$s更新（每 10 分钟自动更新）"

msgid "Sales"
msgstr "销售额"

msgid "Paid orders"
msgstr "已付款订单"

msgid "Average order value"
msgstr "客单价"

msgid "Visitors"
msgstr "访客"

msgid "Conversion rate"
msgstr "转化率"

msgid "Stores online"
msgstr "在线店铺"

msgid "Open alerts"
msgstr "未处理告警"

msgid "By store"
msgstr "各店铺"

msgid "To ship"
msgstr "待发货"

msgid "Last order"
msgstr "最后一单"

msgid "Open store admin"
msgstr "进入后台"

msgid "Sales are paid orders minus refunds. Days follow each store’s time zone. Visitors are counted only on stores with visitor tracking turned on."
msgstr "销售额 = 已付款订单减去退款。日期按各店铺的时区。访客只统计开启了访客追踪的店铺。"

msgid "Daily sales, all stores (last %d days)"
msgstr "每天销售额（所有店铺，近 %d 天）"

msgid "Daily sales chart; the table below lists the same numbers."
msgstr "每天销售额的柱状图；下面的表格列出同样的数字。"

msgid "%1$s: %2$s, %3$d orders"
msgstr "%1$s：%2$s，%3$d 单"

msgid "Show the numbers by day"
msgstr "查看每天的数字"

msgid "Date"
msgstr "日期"

msgid "Orders"
msgstr "订单"

msgid "Products"
msgstr "商品"

msgid "Customers"
msgstr "顾客"

msgid "Marketing campaigns"
msgstr "营销活动"

msgid "Data"
msgstr "数据"

msgid "Blog"
msgstr "博客"

msgid "Store design"
msgstr "店铺装修"

msgid "Store settings"
msgstr "店铺设置"

msgid "Admin settings"
msgstr "后台设置"

msgid "App center"
msgstr "应用中心"

msgid "Master admin"
msgstr "总后台"

msgid "Stores"
msgstr "店铺"

msgid "Servers"
msgstr "服务器"

msgid "Sorry, you are not allowed to do that."
msgstr "抱歉，你没有权限这样做。"

msgid "Refreshed: %1$d of %2$d stores reached."
msgstr "已刷新：%2$d 个店铺中连上了 %1$d 个。"

msgid "Name saved."
msgstr "名称已保存。"

msgid "New registration secret created. Stores already connected keep working; use the new lines when you open a new store."
msgstr "已生成新的注册密钥。已经接入的店铺照常可用；以后开新店铺时用新的两行。"

msgid "Store removed from the master admin. The store itself is not changed; if it still has the master admin lines in wp-config.php, it joins again by itself within a day."
msgstr "已从总后台移除这个店铺，店铺本身不受影响。如果它的 wp-config.php 里还有总后台的两行，一天之内会自己重新接入。"

msgid "Server saved, but the store could not be told yet (%s). It is sent again at the next check."
msgstr "服务器已保存，但暂时没能通知店铺（%s）。下次检查时会再发送。"

msgid "Server assigned. The store’s Domains page now shows this IP for the DNS records."
msgstr "服务器已分配。店铺“域名管理”里的解析记录现在指向这个 IP。"

msgid "Server removed from this store."
msgstr "已取消这个店铺的服务器。"

msgid "Saved on the store."
msgstr "已保存到店铺。"

msgid "Server saved."
msgstr "服务器已保存。"

msgid "Server deleted."
msgstr "服务器已删除。"

msgid "The store did not return a login link."
msgstr "店铺没有返回登录链接。"

msgid "Salesperson account saved on the store."
msgstr "销售账号已保存到店铺。"

msgid "Salesperson account created on the store. Tell the salesperson the account name and password."
msgstr "已在店铺上创建销售账号，请把账号和密码告诉销售。"

msgid "Account not found on the store."
msgstr "店铺上找不到这个账号。"

msgid "Account disabled. The salesperson is logged out of the store."
msgstr "账号已停用，销售已被退出店铺后台。"

msgid "Account enabled."
msgstr "账号已启用。"

msgid "Account deleted. Its posts and products were moved to the store administrator."
msgstr "账号已删除，他发布的博客和商品已转给店铺管理员。"

msgid "Alert marked as handled."
msgstr "告警已标记为已处理。"

msgid "Online"
msgstr "在线"

msgid "Offline"
msgstr "离线"

msgid "Code invalid"
msgstr "连接码失效"

msgid "Checking"
msgstr "检测中"

msgid "%s ago"
msgstr "%s前"

msgid "Register your servers here, then assign one to each store on the Stores page. When a salesperson adds a domain in their store, the DNS records point to the IP of the assigned server; they set the records at their domain registrar themselves."
msgstr "在这里登记你的服务器，再到“店铺”页面给每个店铺分配一台。销售在自己店铺里添加域名时，解析记录就指向分配的服务器 IP，他们自己去域名服务商那里解析。"

msgid "IP address"
msgstr "IP 地址"

msgid "Note"
msgstr "备注"

msgid "Stores on it"
msgstr "使用的店铺"

msgid "Delete this server from the list?"
msgstr "从列表里删除这台服务器？"

msgid "Edit server"
msgstr "编辑服务器"

msgid "Add server"
msgstr "添加服务器"

msgid "For example US-West 1"
msgstr "例如 美西 1 号"

msgid "Provider, location, renewal date…"
msgstr "服务商、机房位置、续费日期……"

msgid "Changing the IP sends the new address to every store on this server right away; their salespeople must update their DNS records."
msgstr "修改 IP 后，新地址会马上发给使用这台服务器的所有店铺，这些店铺的销售需要更新域名解析。"

msgid "Save server"
msgstr "保存服务器"

msgid "Opening a new store"
msgstr "开新店铺"

msgid "Every store you open joins the master admin by itself. When you set up a new store, add these two lines to its wp-config.php (above “That’s all, stop editing!”). The store appears here as soon as its admin is opened once (at the latest within a day)."
msgstr "你开的每个店铺都会自己接入总后台。开新店铺时，把下面两行加到它的 wp-config.php 里（放在“That’s all, stop editing!”上面）。店铺后台打开一次后，它就会出现在这里（最晚一天内）。"

msgid "Lines for wp-config.php"
msgstr "加到 wp-config.php 的两行"

msgid "The secret only lets a store join; each store makes its own key for everything else. Keep the lines private."
msgstr "这个密钥只用来让店铺接入；其他操作都用每个店铺自己生成的密钥。这两行不要给别人。"

msgid "Create a new registration secret? Stores already connected keep working. Stores opened later need the new lines."
msgstr "生成新的注册密钥？已经接入的店铺照常可用，以后开的店铺要用新的两行。"

msgid "Create a new secret (if the old one leaked)"
msgstr "重新生成密钥（旧的可能泄露时）"

msgid "Server"
msgstr "服务器"

msgid "Domains"
msgstr "域名"

msgid "Search engines"
msgstr "搜索引擎收录"

msgid "Visitor tracking"
msgstr "访客追踪"

