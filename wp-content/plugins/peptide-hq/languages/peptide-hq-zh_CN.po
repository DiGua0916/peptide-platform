msgstr "启用的插件：%s"

msgid "Keep visitor data for"
msgstr "访客数据保留"

msgid "%d days"
msgstr "%d 天"

msgid "Save name"
msgstr "保存名称"

msgid "Remove this store from the master admin? Its numbers and alerts here are deleted; the store itself keeps running."
msgstr "从总后台移除这个店铺？总后台里它的数据和告警会删除，店铺本身照常运行。"

msgid "Remove from master admin"
msgstr "从总后台移除"

msgid "Store unreachable"
msgstr "店铺连不上"

msgid "Connection code no longer valid"
msgstr "连接码失效"

msgid "Domain not connected"
msgstr "域名连不上"

msgid "HTTPS not working"
msgstr "HTTPS 不能用"

msgid "No orders for a while"
msgstr "很久没有订单"

msgid "Store not open to the public"
msgstr "店铺没有对外开放"

msgid "[Master admin] %1$s: %2$s"
msgstr "[总后台] %1$s：%2$s"

msgid "The store refused the connection key. Paste the current connection code from the store."
msgstr "店铺拒绝了连接密钥。请到店铺复制最新的连接码贴过来。"

msgid "The store answered with HTTP status %d. Is peptide-core up to date there?"
msgstr "店铺返回了 HTTP 状态码 %d。店铺上的 peptide-core 是最新版本吗？"

msgid "Store not found."
msgstr "找不到这个店铺。"

msgid "The store could not be reached twice in a row: %s"
msgstr "连续两次连不上店铺：%s"

msgid "%s does not reach the store. Check its DNS records."
msgstr "%s 连不到店铺，请检查域名解析记录。"

msgid "HTTPS does not work on %s. Visitors see a security warning."
msgstr "%s 的 HTTPS 不能用，访客会看到安全警告。"

msgid "No order for %1$d hours, although the store had %2$s orders a day over the last 7 days."
msgstr "已经 %1$d 小时没有订单，而最近 7 天平均每天有 %2$s 单。"

msgid "The store is in “coming soon” mode: customers cannot see it."
msgstr "店铺处于“即将开业”模式，顾客看不到。"

msgid "Plugins"
msgstr "插件"

msgid "Install, turn on or off and update plugins."
msgstr "安装、启用、停用和更新插件。"

msgid "Themes"
msgstr "主题"

msgid "The store theme. Change it only together with the theme developer."
msgstr "店铺使用的主题。要换主题请先和主题开发者商量。"

msgid "Updates"
msgstr "更新"

msgid "WordPress, plugin and theme updates."
msgstr "WordPress、插件和主题的更新。"

msgid "System status"
msgstr "系统状态"

msgid "Server, database and plugin information for troubleshooting."
msgstr "服务器、数据库和插件信息，用于排查问题。"

msgid "Scheduled actions"
msgstr "计划任务"

