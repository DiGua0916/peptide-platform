msgstr "— 未分配 —"

msgid "Add a server first"
msgstr "请先添加服务器"

msgid "Not on the store yet; sent again at the next check."
msgstr "店铺还没收到，下次检查时会再发送。"

msgid "+%d other domains"
msgstr "另外还有 %d 个域名"

msgid "Allow search engines to index this store?"
msgstr "允许搜索引擎收录这个店铺？"

msgid "Hide this store from search engines?"
msgstr "不让搜索引擎收录这个店铺？"

msgid "Start recording visitors on this store?"
msgstr "开始记录这个店铺的访客？"

msgid "Stop recording visitors on this store? Data already collected is kept."
msgstr "停止记录这个店铺的访客？已经记录的数据会保留。"

msgid "kept %d days"
msgstr "保留 %d 天"

msgid "Refresh"
msgstr "刷新"

msgid "More"
msgstr "更多"

msgid "Platform tools"
msgstr "平台工具"

msgid "Not shown in the store admin; opens the store page logged in as administrator."
msgstr "店铺后台不显示这些页面；点一下以管理员身份登录后直接打开。"

